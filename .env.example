# Copy this file to .env and fill in your values.
# See docs/IMPLEMENTATION-PLAN.md for details.

JMAP_BASE_URL=https://mail.yourdomain.com
SESSION_SECRET=generate-with-node-crypto-randombytes-32
OAUTH_CLIENT_ID=native-mail
OAUTH_CLIENT_SECRET=register-in-stalwart-webui
OAUTH_REDIRECT_URI=https://mail.yourdomain.com/api/auth/callback
OAUTH_SCOPE=urn:ietf:params:jmap:core urn:ietf:params:jmap:mail urn:ietf:params:jmap:submission
NODE_ENV=production
