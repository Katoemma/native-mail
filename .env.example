# Copy this file to .env and fill in your values.
# See docs/IMPLEMENTATION-PLAN.md for architecture details.

# Stalwart base URL — OAuth + JMAP endpoints are auto-discovered from here
JMAP_BASE_URL=https://mail.yourdomain.com

# Session cookie signing secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=generate-with-node-crypto-randombytes-32

# OAuth client — register in Stalwart WebUI: Management › Directory › OAuth Clients
# requireClientRegistration defaults to false, so any client_id works without pre-registration
OAUTH_CLIENT_ID=native-mail
OAUTH_CLIENT_SECRET=leave-blank-for-public-client-or-set-from-stalwart-webui
OAUTH_REDIRECT_URI=https://mail.yourdomain.com/api/auth/callback
OAUTH_SCOPE=urn:ietf:params:jmap:core urn:ietf:params:jmap:mail urn:ietf:params:jmap:submission

NODE_ENV=production
